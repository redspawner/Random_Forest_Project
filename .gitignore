# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Trained models (re-create with train.py or the app)
models/*
!models/.gitkeep
# ...except the shipped default model
!models/default/

# PATIENT DATA MUST NEVER BE COMMITTED.
# Only the synthetic demo files and the template are tracked.
data/*
!data/synthetic/
!data/default_training/
!data/README.md
*_results.xlsx
*_with_predictions.xlsx
outputs/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
~$*.xlsx
# example files are tracked even when they look like outputs
!examples/*.xlsx

# portable Windows bundle (build with tools/build_portable.py)
dist/
